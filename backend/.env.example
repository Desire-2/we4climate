# =============================================================================
# We4Climate API – Environment Variables
# Copy this file to .env (or set these in your Render dashboard) and fill in
# the values. Never commit the real .env file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (used on Render). If unset, the app falls back
# to a local SQLite file.
DATABASE_URL="postgresql://user:password@host:5432/we4climate"

# --- Flask ------------------------------------------------------------------
# Flask secret key – use a long random value in production.
SECRET_KEY="change-me-in-production"
# Port to bind (default: 5000). Render injects PORT automatically.
PORT=5000
# Number of Gunicorn worker processes (default: 4).
GUNICORN_WORKERS=4

# --- Email delivery (Brevo) -------------------------------------------------
# Brevo API key – required for the contact form to email submissions.
# Create one at https://app.brevo.com (Settings → API Keys).
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Inbox that receives contact-form submissions (default: we4climate.rwanda@gmail.com).
CONTACT_RECIPIENT_EMAIL="we4climate.rwanda@gmail.com"
# Verified sender address in Brevo – the address (or its domain) must be
# verified in the Brevo dashboard before emails can be delivered.
CONTACT_SENDER_EMAIL="noreply@we4climate.org"
# Sender display name shown on delivered emails.
CONTACT_SENDER_NAME="We4Climate"

# --- Vercel Blob Storage ----------------------------------------------------
# Required for file uploads (volunteer documents, application attachments).
# Get this from your Vercel project dashboard → Storage → Blob → Settings.
# Or run `vercel env pull` to download it automatically.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- CORS -------------------------------------------------------------------
# Frontend origin allowed to call this API. Set to the deployed frontend URL
# in production (e.g. https://we4climate.vercel.app). Leave unset in
# development to allow all origins.
FRONTEND_URL=""
